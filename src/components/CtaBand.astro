---
import Icon from './Icon.astro';
import { company, waLink } from '../data/site';
interface Props { msg?: string }
const { msg } = Astro.props;
---
<section aria-labelledby="cta-heading" class="relative isolate overflow-hidden bg-navy-800">
  <div aria-hidden="true" class="absolute -top-32 -right-32 -z-10 h-96 w-96 rounded-full bg-accent-600/30 blur-3xl"></div>
  <div aria-hidden="true" class="absolute -bottom-40 -left-24 -z-10 h-80 w-80 rounded-full bg-accent-400/10 blur-3xl"></div>
  <div class="mx-auto flex max-w-content flex-col items-start gap-8 px-4 py-16 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
    <div class="max-w-2xl">
      <h2 id="cta-heading" class="font-heading text-3xl font-bold tracking-tight text-white">Punya rencana proyek atau kebutuhan pengadaan?</h2>
      <p class="mt-3 text-lg leading-relaxed text-slate-300">Kirim kebutuhan Anda. Kami bantu hitung estimasi dan susun penawaran.</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      {company.wa.map((w, i) => (
        <a href={waLink(msg, i)} target="_blank" rel="noopener"
           class:list={['inline-flex min-h-14 items-center justify-center gap-2.5 rounded-xl px-7 text-base font-bold transition-colors',
             i === 0 ? 'bg-wa-500 text-navy-950 shadow-lift hover:bg-wa-600' : 'border-2 border-white/30 text-white hover:border-white/60 hover:bg-white/10']}>
          <Icon name="wa" />{w.label}
        </a>
      ))}
    </div>
  </div>
</section>
