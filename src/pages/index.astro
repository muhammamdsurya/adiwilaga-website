---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Roadmap from '../components/Roadmap.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { stats, legal, sectors, services, products, faq, heroSlides, img, waLink } from '../data/site';
import { organization, website, faqPage } from '../data/schema';
import { preloadOf } from '../data/images';

const preload = await preloadOf(heroSlides[0].img);
---
<Base
  title="Kontraktor Umum & Pengadaan Barang Jasa di Bekasi | Adiwilaga Agung"
  description="Adiwilaga Agung, kontraktor umum dan pengadaan barang jasa di Bekasi sejak 2015: konstruksi, service mesin kantor & bank, pemusnahan dokumen, percetakan, material, CCTV."
  jsonld={[organization, website, faqPage(faq)]}
  preload={preload}
>
  <Hero />

  <!-- Bukti: angka pencapaian menumpang di tepi bawah hero -->
  <div class="relative z-10 -mt-14 px-4 sm:px-6 lg:-mt-16 lg:px-8">
    <dl class="reveal mx-auto grid max-w-content grid-cols-2 gap-y-6 rounded-2xl bg-white px-6 py-7 shadow-lift ring-1 ring-slate-200 sm:px-8 lg:grid-cols-4 lg:divide-x lg:divide-slate-200 lg:px-0">
      {stats.map((s) => (
        <div class="flex flex-col-reverse lg:px-8">
          <dt class="mt-1 text-[15px] font-semibold text-slate-600">{s.label}</dt>
          <dd class="font-heading text-4xl font-bold text-navy-800"><span class="counter">{s.value}</span><span class="text-accent-600">{s.suffix}</span></dd>
        </div>
      ))}
    </dl>
  </div>

  <section id="tentang-kami" class="bg-white py-16 sm:py-20 lg:py-24">
    <div class="mx-auto grid max-w-content gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div class="reveal">
        <h2 class="section-rule font-heading text-3xl font-bold tracking-tight text-navy-800 lg:text-4xl">Tentang Adiwilaga Agung</h2>
        <div class="mt-7 space-y-4 text-lg leading-relaxed text-slate-600">
          <p>Adiwilaga Agung adalah kontraktor umum dan penyedia pengadaan barang jasa yang berdiri sejak 2015 di Bekasi, Jawa Barat. Kami berawal dari perbaikan dan perawatan alat kantor untuk perbankan, lalu berkembang menjadi penyedia solusi terpadu.</p>
          <p>Setiap pekerjaan dijalankan sesuai spesifikasi, jadwal yang disepakati, biaya yang transparan, dan dokumentasi yang tertib.</p>
        </div>
        <h3 class="mt-9 font-heading text-lg font-semibold text-navy-800">Klien yang kami layani</h3>
        <ul class="mt-4 grid grid-cols-2 gap-3 text-[15px] font-semibold text-navy-700">
          {sectors.map((s) => (
            <li class="flex items-center gap-3 rounded-xl border border-slate-200 p-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-accent-100 text-accent-700"><Icon name={s.icon} /></span>{s.name}
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal self-start rounded-3xl bg-navy-800 p-6 text-slate-300 sm:p-8">
        <h3 class="font-heading text-xl font-semibold text-white">Legalitas Perusahaan</h3>
        <p class="mt-2 text-[15px]">Badan usaha resmi dan terdaftar. Salinan dokumen kami kirimkan atas permintaan.</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {legal.map((l) => (
            <li class="flex items-start gap-3 rounded-2xl bg-white/5 p-4 ring-1 ring-white/10">
              <Icon name="shield" class="mt-0.5 h-6 w-6 shrink-0 text-accent-400" />
              <span><strong class="block font-heading font-semibold text-white">{l.name}</strong>{l.desc}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="layanan" class="border-y border-slate-200 bg-slate-50 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="section-rule is-center font-heading text-3xl font-bold tracking-tight text-navy-800 lg:text-4xl">Layanan Kontraktor &amp; Pengadaan</h2>
        <p class="mt-6 text-lg text-slate-600">Sepuluh lini layanan dari satu penyedia. Pilih layanan untuk melihat cakupan dan dokumentasi pekerjaan.</p>
      </div>
      <!-- Bento: dua layanan inti tampil lebar, sehingga 10 kartu mengisi baris dengan rapi di 3 & 4 kolom -->
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-flow-dense lg:grid-cols-3 xl:grid-cols-4">
        {services.map((s, i) => (
          <li class:list={['reveal', { 'lg:col-span-2': i < 2 }]}>
            <a href={`/layanan/${s.slug}/`} class:list={['group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card transition duration-300 hover:-translate-y-1 hover:border-accent-600/40 hover:shadow-lift', { 'lg:flex-row': i < 2 }]}>
              <div class:list={['aspect-4/3 overflow-hidden bg-navy-800', { 'lg:aspect-auto lg:w-1/2 lg:shrink-0': i < 2 }]}>
                <Image src={img(s.cover)} alt={s.alt} widths={[400, 640]} sizes="(min-width: 1280px) 290px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                       class="h-full w-full object-cover transition duration-500 group-hover:scale-105" style={`view-transition-name: svc-${s.slug}`} />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-heading text-lg leading-snug font-semibold text-navy-800">{s.title}</h3>
                <p class:list={['mt-3 text-[15px] leading-relaxed text-slate-600', { 'line-clamp-3': i >= 2 }]}>{s.lead}</p>
                <ul class="mt-4 flex-1 space-y-2">
                  {s.points.map((p) => <li class="flex items-start gap-2 text-[15px] font-semibold text-navy-700"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-700" />{p}</li>)}
                </ul>
                <span class="mt-6 inline-flex items-center gap-2 font-bold text-accent-700">
                  Lihat detail<Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Roadmap />

  <section id="produk" class="border-t border-slate-200 bg-slate-50 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
      <div class="reveal flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="section-rule font-heading text-3xl font-bold tracking-tight text-navy-800 lg:text-4xl">Produk &amp; Material Bangunan</h2>
        <p class="text-base leading-relaxed text-slate-600 sm:max-w-xs sm:text-right">Harga khusus untuk volume proyek. Spesifikasi lain tersedia atas permintaan.</p>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
        {products.map((p) => (
          <li class="reveal flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card">
            <Image src={img(p.img)} alt={p.alt} widths={[320, 480]} sizes="(min-width: 1280px) 224px, (min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="aspect-square w-full object-cover" />
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-heading text-base leading-snug font-semibold text-navy-800">{p.name}</h3>
              <p class="mt-1.5 text-sm font-semibold text-accent-700">{p.spec}</p>
              <ul class="mt-3.5 flex-1 space-y-1.5">
                {p.points.map((k) => <li class="flex items-start gap-2 text-sm leading-snug text-slate-600"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-700" />{k}</li>)}
              </ul>
              <a href={waLink(`Halo Adiwilaga Agung, saya ingin bertanya tentang produk ${p.name}.`)} target="_blank" rel="noopener" aria-label={`Tanya produk via WhatsApp: ${p.name}`}
                 class="mt-5 inline-flex min-h-[46px] items-center justify-center gap-2 rounded-xl border-2 border-navy-800 px-4 text-[15px] font-bold text-navy-800 transition-colors hover:bg-navy-800 hover:text-white">
                <Icon name="wa" class="h-[18px] w-[18px]" />Tanya Produk
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq />
  <CtaBand />
</Base>
