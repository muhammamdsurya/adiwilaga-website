# ============================================================================
# .htaccess — Adiwilaga Agung
# ----------------------------------------------------------------------------
# Deskripsi : Konfigurasi Apache untuk shared hosting (cPanel/Plesk).
#             Menangani: paksa HTTPS, kompresi, cache browser, dan header
#             keamanan dasar. Ini yang membuat skor Lighthouse "Best
#             Practices" & "Performance" tetap tinggi di shared hosting.
# CATATAN   : File ini HANYA berlaku untuk Apache. Jika hosting di
#             Netlify / Vercel / GitHub Pages, file ini diabaikan (aman
#             dibiarkan) — HTTPS & kompresi sudah otomatis di platform itu.
# Tanggal Modifikasi : 17 Agustus 2026
# ============================================================================

# ---------------------------------------------------------------------------
# 1. PAKSA HTTPS (wajib sesuai Non-Functional Requirement)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Hilangkan index.html dari URL (opsional, URL lebih bersih)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# 2. KOMPRESI GZIP — memperkecil ukuran transfer HTML/CSS/JS/SVG
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 3. CACHE BROWSER — kunjungan berikutnya jadi hampir instan
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  # HTML tidak di-cache lama agar perubahan konten langsung terlihat
  ExpiresByType text/html                 "access plus 0 seconds"

  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/plain                "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|webp|jpg|jpeg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # -------------------------------------------------------------------------
  # 4. HEADER KEAMANAN DASAR
  # -------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# 5. MIME TYPE (beberapa shared hosting lama belum mengenal WebP/SVG)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp    .webp
  AddType image/svg+xml .svg
  AddType font/woff2    .woff2
</IfModule>

# ---------------------------------------------------------------------------
# 6. Sembunyikan listing folder & file konfigurasi
# ---------------------------------------------------------------------------
Options -Indexes

<FilesMatch "^\.(htaccess|htpasswd|git)">
  Require all denied
</FilesMatch>
